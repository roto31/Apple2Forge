+uint8_t Emu6502::cmosDecimalFlags(uint8_t result) {
+  // The 65C02 sets N and Z from the decimal result and takes one more cycle;
+  // the 6502's N and Z come from the binary sum. ProDOS 8 2.x tells the two
+  // CPUs apart this way.
+  if (!cmos_)
+    return result;
+  status_ &= ~(STATUS_N | STATUS_Z);
+  status_ |= (result & STATUS_N) | (result ? 0 : STATUS_Z);
+  ++cycles_;
+  return result;
+}

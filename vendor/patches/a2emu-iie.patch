+/* --- //e video ------------------------------------------------------------ */
+
+constexpr unsigned kWideW = 560;
+constexpr unsigned kTextRows = 24;
+constexpr unsigned kMixedTextRow = 20;
+constexpr unsigned kDotsPerCell = 7;
+constexpr unsigned kWideCellW = 14;
+/// Same rate as a2io's 40-column flash.
+constexpr uint64_t kFlashPeriodMs = 267;
+const a2_rgba8 kLit = {0xFF, 0xFF, 0xFF, 0};
+const a2_rgba8 kDark = {0, 0, 0, 0};
+/// The lo-res palette, which double hi-res shares; same values as a2io's.
+const a2_rgba8 kLoresColors[16] = {
+    {0, 0, 0, 0},       {227, 30, 96, 0},   {96, 78, 189, 0},   {255, 68, 253, 0},
+    {0, 163, 96, 0},    {156, 156, 156, 0}, {20, 207, 253, 0},  {208, 195, 255, 0},
+    {96, 114, 3, 0},    {255, 106, 60, 0},  {156, 156, 156, 0}, {255, 160, 208, 0},
+    {20, 245, 60, 0},   {208, 221, 141, 0}, {114, 255, 208, 0}, {255, 255, 255, 0},
+};
+
+unsigned textRowOffset(unsigned row) {
+  return (row % 8) * 128 + (row / 8) * 40;
+}
+unsigned hiresLineOffset(unsigned line) {
+  return (line % 8) * 0x400 + ((line / 8) % 8) * 0x80 + (line / 64) * 40;
+}
+
+struct WideTarget {
+  a2_rgba8 *pixels;
+  unsigned stride;
+  a2_rgba8 *at(unsigned x, unsigned y) const {
+    return pixels + y * stride + x;
+  }
+};
+
+/// One character cell, \p dotWidth screen dots per character dot. In the
+/// primary set $40-$7F flash between inverse and normal; ALTCHARSET shows
+/// MouseText and inverse lower case there instead.
+void drawChar(const WideTarget &t, unsigned x0, unsigned row, uint8_t ch, unsigned dotWidth, bool flashPhase,
+              bool altchar) {
+  unsigned glyph = ch;
+  bool invert = false;
+  if (!altchar && ch >= 0x40 && ch < 0x80) {
+    glyph = ch & 0x3F;
+    invert = flashPhase;
+  }
+  const uint8_t *bits = s_videoRom.data() + glyph * 8;
+  for (unsigned line = 0; line != 8; ++line) {
+    a2_rgba8 *d = t.at(x0, row * 8 + line);
+    for (unsigned dot = 0; dot != kDotsPerCell; ++dot) {
+      bool lit = !((bits[line] >> dot) & 1) != invert;
+      for (unsigned w = 0; w != dotWidth; ++w)
+        *d++ = lit ? kLit : kDark;
+    }
+  }
+}
+
+void drawTextRows(const WideTarget &t, unsigned firstRow, uint16_t base, bool col80, bool altchar, uint64_t ms) {
+  bool flashPhase = (ms / kFlashPeriodMs) & 1;
+  for (unsigned row = firstRow; row != kTextRows; ++row) {
+    uint16_t offset = (uint16_t)(base + textRowOffset(row));
+    for (unsigned col = 0; col != 40; ++col) {
+      uint8_t mainCh = s_emu.bankByte(false, (uint16_t)(offset + col));
+      if (col80) {
+        drawChar(t, col * kWideCellW, row, s_emu.bankByte(true, (uint16_t)(offset + col)), 1, flashPhase, altchar);
+        drawChar(t, col * kWideCellW + kDotsPerCell, row, mainCh, 1, flashPhase, altchar);
+      } else {
+        drawChar(t, col * kWideCellW, row, mainCh, 2, flashPhase, altchar);
+      }
+    }
+  }
+}
+
+void fillLoresBlock(const WideTarget &t, unsigned x0, unsigned width, unsigned row, uint8_t value) {
+  for (unsigned line = 0; line != 8; ++line) {
+    const a2_rgba8 &color = kLoresColors[line < 4 ? value & 0x0F : value >> 4];
+    a2_rgba8 *d = t.at(x0, row * 8 + line);
+    for (unsigned x = 0; x != width; ++x)
+      *d++ = color;
+  }
+}
+
+unsigned rol4(unsigned nibble) {
+  return ((nibble << 1) | (nibble >> 3)) & 0x0F;
+}
+
+/// Double lo-res shows each auxiliary nibble rotated one bit left.
+uint8_t rotateAuxLores(uint8_t value) {
+  return (uint8_t)(rol4(value & 0x0F) | (rol4(value >> 4) << 4));
+}
+
+void drawLoresRows(const WideTarget &t, unsigned lastRow, uint16_t base, bool doubleRes) {
+  for (unsigned row = 0; row != lastRow; ++row) {
+    uint16_t offset = (uint16_t)(base + textRowOffset(row));
+    for (unsigned col = 0; col != 40; ++col) {
+      uint8_t mainValue = s_emu.bankByte(false, (uint16_t)(offset + col));
+      if (doubleRes) {
+        uint8_t auxValue = rotateAuxLores(s_emu.bankByte(true, (uint16_t)(offset + col)));
+        fillLoresBlock(t, col * kWideCellW, kDotsPerCell, row, auxValue);
+        fillLoresBlock(t, col * kWideCellW + kDotsPerCell, kDotsPerCell, row, mainValue);
+      } else {
+        fillLoresBlock(t, col * kWideCellW, kWideCellW, row, mainValue);
+      }
+    }
+  }
+}
+
+/// Double hi-res: each line is 560 dots, seven from an auxiliary byte then
+/// seven from the main byte at the same address, low bit first. In colour
+/// every four dots are one pixel of the lo-res palette, numbered so that the
+/// fourth dot is bit 0 (Apple IIe Technical Note #3, Table 2: magenta, colour
+/// 1, is aux $08 / main $11, which lights dots 3, 7, 11, ...).
+void drawDoubleHiresLines(const WideTarget &t, unsigned lastLine, uint16_t base, bool mono) {
+  uint8_t dots[kWideW];
+  for (unsigned line = 0; line != lastLine; ++line) {
+    uint16_t offset = (uint16_t)(base + hiresLineOffset(line));
+    for (unsigned col = 0; col != 40; ++col) {
+      uint8_t auxByte = s_emu.bankByte(true, (uint16_t)(offset + col));
+      uint8_t mainByte = s_emu.bankByte(false, (uint16_t)(offset + col));
+      for (unsigned bit = 0; bit != kDotsPerCell; ++bit) {
+        dots[col * kWideCellW + bit] = (auxByte >> bit) & 1;
+        dots[col * kWideCellW + kDotsPerCell + bit] = (mainByte >> bit) & 1;
+      }
+    }
+    a2_rgba8 *d = t.at(0, line);
+    if (mono) {
+      for (unsigned x = 0; x != kWideW; ++x)
+        d[x] = dots[x] ? kLit : kDark;
+      continue;
+    }
+    for (unsigned x = 0; x != kWideW; x += 4) {
+      unsigned value = dots[x] | dots[x + 1] << 1 | dots[x + 2] << 2 | dots[x + 3] << 3;
+      for (unsigned i = 0; i != 4; ++i)
+        d[x + i] = kLoresColors[rol4(value)];
+    }
+  }
+}
+
+/// 40-column hi-res goes through a2io's renderer (all four F3 modes) at 280
+/// dots, then every dot is doubled.
+void drawHiresLines(const WideTarget &t, unsigned lastLine, uint16_t base, bool mixed, uint64_t ms, int hgrMode) {
+  static a2_screen narrow;
+  static uint8_t page[0x2000];
+  static uint8_t textPage[0x400];
+  for (unsigned i = 0; i != sizeof(page); ++i)
+    page[i] = s_emu.bankByte(false, (uint16_t)(base + i));
+  memset(textPage, 0xA0, sizeof(textPage));
+  auto mode = (a2_hgr_mode_t)hgrMode;
+  apple2_render_hgr_screen_mode(page, textPage, &narrow, ms, mixed, mode);
+  if (mode == A2_HGR_COLOR140 || mode == A2_HGR_MONO140)
+    apple2_widen_hgr_cells(&narrow, mixed);
+  for (unsigned line = 0; line != lastLine; ++line) {
+    const a2_rgba8 *src = narrow.data + line * A2_SCREEN_W_POT;
+    a2_rgba8 *d = t.at(0, line);
+    for (unsigned x = 0; x != A2_SCREEN_W; ++x)
+      d[2 * x] = d[2 * x + 1] = src[x];
+  }
+}

+extern "C" bool engine_video_wide(void) {
+  return s_model == "iie";
+}
+
+extern "C" void engine_render_wide(a2_rgba8 *pixels, unsigned stride, uint64_t ms, int hgrMode) {
+  if (!s_emu.isIIe())
+    return;
+  WideTarget t{pixels, stride};
+  auto sw = s_emu.videoSwitches();
+  uint8_t vc = a2host_io()->vid_control;
+  // With 80STORE on, PAGE2 picks a bank rather than the displayed page.
+  bool page2 = !sw.store80 && (vc & A2_VC_PAGE2);
+  uint16_t textBase = page2 ? 0x0800 : 0x0400;
+  uint16_t hiresBase = page2 ? 0x4000 : 0x2000;
+  bool mixed = (vc & A2_VC_MIXED) != 0;
+  bool doubleRes = sw.col80 && sw.dhires;
+
+  if (vc & A2_VC_TEXT) {
+    drawTextRows(t, 0, textBase, sw.col80, sw.altchar, ms);
+    return;
+  }
+  unsigned graphicsRows = mixed ? kMixedTextRow : kTextRows;
+  if (!(vc & A2_VC_HIRES))
+    drawLoresRows(t, graphicsRows, textBase, doubleRes);
+  else if (doubleRes)
+    drawDoubleHiresLines(t, graphicsRows * 8, hiresBase,
+                         hgrMode == A2_HGR_MONO || hgrMode == A2_HGR_MONO140);
+  else
+    drawHiresLines(t, graphicsRows * 8, hiresBase, mixed, ms, hgrMode);
+  if (mixed)
+    drawTextRows(t, kMixedTextRow, textBase, sw.col80, sw.altchar, ms);
+}

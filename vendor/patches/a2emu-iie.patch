+bool Emu6502::execCMOS(uint8_t opcode) {
+#define OP8() peek(pc_ + 1)
+#define OP16() peek16(pc_ + 1)
+  auto charge = [this](unsigned cycles, unsigned length) {
+    cycles_ += cycles;
+    pc_ += length;
+  };
+  // (zp): the 16-bit address held in the zero page, without indexing.
+  auto zpIndirect = [this]() -> uint16_t { return peek16_zpg(OP8()); };
+  auto testAndModify = [this](uint8_t m, bool set) -> uint8_t {
+    status_ = (status_ & ~STATUS_Z) | (a_ & m ? 0 : STATUS_Z);
+    return set ? (m | a_) : (m & ~a_);
+  };
+  auto bitFlags = [this](uint8_t m) {
+    status_ = (status_ & ~(0xC0 | STATUS_Z)) | (m & 0xC0) | (a_ & m ? 0 : STATUS_Z);
+  };
+  auto adc = [this](uint8_t m) {
+    a_ = (status_ & STATUS_D) ? adcDecimal(m) : updateNZVC(a_ + m + (status_ & STATUS_C), a_, m);
+  };
+  auto sbc = [this](uint8_t m) {
+    a_ = (status_ & STATUS_D) ? sbcDecimal(m)
+                              : updateNZVInvC(a_ - m - (~status_ & STATUS_C), a_, ~m);
+  };
+
+  switch (opcode) {
+  case 0x80: { // BRA
+    auto offset = (int8_t)OP8();
+    pc_ += 2 + offset;
+    cycles_ += 3;
+    return true;
+  }
+  case 0xDA: // PHX
+    push8(x_);
+    charge(3, 1);
+    return true;
+  case 0x5A: // PHY
+    push8(y_);
+    charge(3, 1);
+    return true;
+  case 0xFA: // PLX
+    x_ = updateNZ(pop8());
+    charge(4, 1);
+    return true;
+  case 0x7A: // PLY
+    y_ = updateNZ(pop8());
+    charge(4, 1);
+    return true;
+  case 0x64: // STZ zpg
+    poke_zpg(OP8(), 0);
+    charge(3, 2);
+    return true;
+  case 0x74: // STZ zpg,X
+    poke_zpg_x(OP8(), 0);
+    charge(4, 2);
+    return true;
+  case 0x9C: // STZ abs
+    poke(OP16(), 0);
+    charge(4, 3);
+    return true;
+  case 0x9E: // STZ abs,X
+    poke_abs_x(OP16(), 0);
+    charge(5, 3);
+    return true;
+  case 0x04: // TSB zpg
+  case 0x14: { // TRB zpg
+    uint8_t addr = OP8();
+    poke_zpg(addr, testAndModify(peek_zpg(addr), opcode == 0x04));
+    charge(5, 2);
+    return true;
+  }
+  case 0x0C: // TSB abs
+  case 0x1C: { // TRB abs
+    uint16_t addr = OP16();
+    poke(addr, testAndModify(peek(addr), opcode == 0x0C));
+    charge(6, 3);
+    return true;
+  }
+  case 0x1A: // INC A
+    a_ = updateNZ(a_ + 1);
+    charge(2, 1);
+    return true;
+  case 0x3A: // DEC A
+    a_ = updateNZ(a_ - 1);
+    charge(2, 1);
+    return true;
+  case 0x89: // BIT #imm affects only Z.
+    status_ = (status_ & ~STATUS_Z) | (a_ & OP8() ? 0 : STATUS_Z);
+    charge(2, 2);
+    return true;
+  case 0x34: // BIT zpg,X
+    bitFlags(peek_zpg_x(OP8()));
+    charge(4, 2);
+    return true;
+  case 0x3C: // BIT abs,X
+    bitFlags(peek_abs_x(OP16()));
+    charge(4, 3);
+    return true;
+  case 0x12: // ORA (zpg)
+    a_ = updateNZ(a_ | peek(zpIndirect()));
+    charge(5, 2);
+    return true;
+  case 0x32: // AND (zpg)
+    a_ = updateNZ(a_ & peek(zpIndirect()));
+    charge(5, 2);
+    return true;
+  case 0x52: // EOR (zpg)
+    a_ = updateNZ(a_ ^ peek(zpIndirect()));
+    charge(5, 2);
+    return true;
+  case 0x72: // ADC (zpg)
+    adc(peek(zpIndirect()));
+    charge(5, 2);
+    return true;
+  case 0x92: // STA (zpg)
+    poke(zpIndirect(), a_);
+    charge(5, 2);
+    return true;
+  case 0xB2: // LDA (zpg)
+    a_ = updateNZ(peek(zpIndirect()));
+    charge(5, 2);
+    return true;
+  case 0xD2: // CMP (zpg)
+    updateNZInvC(a_ - peek(zpIndirect()));
+    charge(5, 2);
+    return true;
+  case 0xF2: // SBC (zpg)
+    sbc(peek(zpIndirect()));
+    charge(5, 2);
+    return true;
+  case 0x7C: // JMP (abs,X)
+    pc_ = peek16((uint16_t)(OP16() + x_));
+    cycles_ += 6;
+    return true;
+  // The rest of the 65C02's opcode map executes as NOPs of fixed length.
+  case 0x02:
+  case 0x22:
+  case 0x42:
+  case 0x62:
+  case 0x82:
+  case 0xC2:
+  case 0xE2:
+    charge(2, 2);
+    return true;
+  case 0x44:
+    charge(3, 2);
+    return true;
+  case 0x54:
+  case 0xD4:
+  case 0xF4:
+    charge(4, 2);
+    return true;
+  case 0x5C:
+    charge(8, 3);
+    return true;
+  case 0xDC:
+  case 0xFC:
+    charge(4, 3);
+    return true;
+  default:
+    if ((opcode & 0x03) == 0x03) { // Columns 3, 7, B and F.
+      charge(1, 1);
+      return true;
+    }
+    return false;
+  }
 #undef OP16
 #undef OP8
 }

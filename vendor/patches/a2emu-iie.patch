+
+void writeFileOrDie(const std::string &path, const void *data, size_t size) {
+  FILE *f = fopen(path.c_str(), "wb");
+  if (!f || fwrite(data, 1, size, f) != size) {
+    perror(path.c_str());
+    exit(2);
+  }
+  fclose(f);
+}
+
+/// <ram_path>.main and <ram_path>.aux: $0000-$BFFF of each bank; and
+/// <ram_path>.iie: the //e switches, one "NAME 0|1" per line.
+void saveIIeState(const char *ram_path) {
+  constexpr unsigned kBankedSize = 0xC000;
+  std::vector<uint8_t> main(kBankedSize), aux(kBankedSize);
+  for (unsigned addr = 0; addr != kBankedSize; ++addr) {
+    main[addr] = s_emu.bankByte(false, (uint16_t)addr);
+    aux[addr] = s_emu.bankByte(true, (uint16_t)addr);
+  }
+  std::string base(ram_path);
+  writeFileOrDie(base + ".main", main.data(), main.size());
+  writeFileOrDie(base + ".aux", aux.data(), aux.size());
+  std::string switches = s_emu.describeSwitches();
+  writeFileOrDie(base + ".iie", switches.data(), switches.size());
+}

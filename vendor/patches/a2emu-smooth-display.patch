+/// One hi-res row in A2_HGR_SMOOTH: see that mode's comment for the rules.
+/// Dots are taken least significant bit first, and a dot's colour comes from
+/// its own byte's bit 7 and its column parity, as in A2_HGR_COLOR.
+static void render_hgr_smooth_row(const uint8_t *rowStart, a2_rgba8 *d) {
+  enum { DOTS = 280 };
+  bool dots[DOTS];
+  uint8_t hiBit[DOTS];
+  for (unsigned bcol = 0, idx = 0; bcol != 40; ++bcol) {
+    uint8_t memb = rowStart[bcol];
+    uint8_t highBit = (memb >> 6) & 2;
+    for (unsigned i = 0; i != 7; memb >>= 1, ++idx, ++i) {
+      dots[idx] = (memb & 1) != 0;
+      hiBit[idx] = highBit;
+    }
+  }
+
+  const a2_rgba8 black = {0, 0, 0};
+  const a2_rgba8 white = {0xFF, 0xFF, 0xFF};
+#define DOT(i) ((i) >= 0 && (i) < DOTS && dots[(i)])
+  for (int i = 0; i != DOTS; ++i) {
+    if (dots[i]) {
+      d[i] = DOT(i - 1) || DOT(i + 1) ? white : s_hgr_artifact_colors[hiBit[i] | (i & 1)];
+    } else if (
+        DOT(i - 1) && DOT(i + 1) && !DOT(i - 2) && !DOT(i + 2) && hiBit[i - 1] == hiBit[i + 1]) {
+      d[i] = s_hgr_artifact_colors[hiBit[i - 1] | ((i - 1) & 1)];
+    } else {
+      d[i] = black;
+    }
+  }
+#undef DOT
+}

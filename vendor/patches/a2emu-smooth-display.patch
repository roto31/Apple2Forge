+enum { VIOLET, GREEN, BLUE, ORANGE, WHITE, BLACK };
+
+static bool is_color(a2_rgba8 c, int which) {
+  static const uint8_t rgb[][3] = {
+      {255, 68, 253}, {20, 245, 60}, {20, 207, 253}, {255, 106, 60}, {255, 255, 255}, {0, 0, 0}};
+  return c.r == rgb[which][0] && c.g == rgb[which][1] && c.b == rgb[which][2];
+}
+
+/// A2_HGR_SMOOTH against the Apple //e Technical Reference Manual's hi-res
+/// colour rules (p. 24-25, Table 2-7). One case per hi-res line, each line
+/// starting at its own 1 KB block of the page.
+static void test_hgr_smooth(void) {
+  static uint8_t page[0x2000];
+  static uint8_t textPage[0x400];
+  static a2_screen screen;
+  page[0x0000] = 0x01;                      // line 0: one dot, even column
+  page[0x0400] = 0x03;                      // line 1: two dots side by side
+  page[0x0800] = 0x55;                      // line 2: even columns 0-6
+  page[0x0C00] = 0xAA;                      // line 3: odd columns 1-5, bit 7 on
+  page[0x1000] = 0x55, page[0x1001] = 0x2A; // line 4: even columns 0-12 across two bytes
+  page[0x1400] = 0x40, page[0x1401] = 0x82; // line 5: columns 6 and 8, different bit 7
+  apple2_render_hgr_screen_mode(page, textPage, &screen, 0, false, A2_HGR_SMOOTH);
+  const a2_rgba8 *line[6];
+  for (unsigned y = 0; y != 6; ++y)
+    line[y] = screen.data + y * A2_SCREEN_W_POT;
+
+  check(is_color(line[0][0], VIOLET) && is_color(line[0][1], BLACK), "smooth: a lone even dot is violet");
+  check(
+      is_color(line[1][0], WHITE) && is_color(line[1][1], WHITE) && is_color(line[1][2], BLACK),
+      "smooth: two adjacent dots are both white");
+  bool solid = true;
+  for (unsigned x = 0; x != 7; ++x)
+    solid = solid && is_color(line[2][x], VIOLET);
+  check(solid && is_color(line[2][7], BLACK), "smooth: a violet fill is solid, not striped");
+  solid = is_color(line[3][0], BLACK) && is_color(line[3][6], BLACK);
+  for (unsigned x = 1; x != 6; ++x)
+    solid = solid && is_color(line[3][x], ORANGE);
+  check(solid, "smooth: odd dots with bit 7 on fill orange");
+  solid = true;
+  for (unsigned x = 0; x != 13; ++x)
+    solid = solid && is_color(line[4][x], VIOLET);
+  check(solid, "smooth: a fill stays solid across a byte boundary");
+  check(
+      is_color(line[5][6], VIOLET) && is_color(line[5][7], BLACK) && is_color(line[5][8], BLUE),
+      "smooth: a gap between two different colours stays black");
+}

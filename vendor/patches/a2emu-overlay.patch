@@ -0,0 +1,320 @@
+/*
+ * Copyright (c) Tzvetan Mikov.
+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+/// \file
+/// The floating buttons over the game window.
+///
+/// They live in a borderless child panel, not in the game window's own view:
+/// the picture is an OpenGL view, which draws over any sibling view. The panel
+/// never becomes key and never activates this process, so the keyboard stays
+/// with the game and the launching app keeps the menu bar (see
+/// a2emu-menu-bar.patch). For the same reason restarting asks for a second
+/// click rather than showing an alert, which would activate this process.
+
+#import <Cocoa/Cocoa.h>
+
+#include "a2host_overlay.h"
+
+static const NSTimeInterval kIdleSeconds = 2.5;
+static const NSTimeInterval kRestartArmSeconds = 3.0;
+static const CGFloat kButtonWidth = 38;
+static const CGFloat kButtonHeight = 30;
+static const CGFloat kPillHeight = 44;
+static const CGFloat kPillPadding = 10;
+static const CGFloat kBottomGap = 16;
+static const CGFloat kCornerRadius = 22;
+
+/// Works on the first click, although its window is never key, and never
+/// takes the keyboard from the game.
+@interface A2OverlayButton : NSButton
+@end
+
+@implementation A2OverlayButton
+- (BOOL)acceptsFirstMouse:(NSEvent *)event {
+  return YES;
+}
+- (BOOL)acceptsFirstResponder {
+  return NO;
+}
+@end
+
+@interface A2OverlayController : NSObject
+@end
+
+@implementation A2OverlayController {
+  NSWindow *_parent;
+  NSPanel *_panel;
+  NSStackView *_stack;
+  a2_overlay_mode_t _mode;
+  a2_overlay_action_fn _fn;
+  NSTimer *_hideTimer;
+  NSTimer *_disarmTimer;
+  BOOL _hovering;
+  BOOL _restartArmed;
+  BOOL _joystickOn;
+  BOOL _soundOn;
+  A2OverlayButton *_restart;
+  A2OverlayButton *_joystick;
+  A2OverlayButton *_sound;
+  A2OverlayButton *_fullscreen;
+}
+
+static NSImage *rounded_mask(CGFloat radius) {
+  CGFloat side = radius * 2 + 1;
+  NSImage *image = [NSImage imageWithSize:NSMakeSize(side, side)
+                                  flipped:NO
+                           drawingHandler:^BOOL(NSRect rect) {
+                             [[NSColor blackColor] set];
+                             [[NSBezierPath bezierPathWithRoundedRect:rect xRadius:radius yRadius:radius] fill];
+                             return YES;
+                           }];
+  image.capInsets = NSEdgeInsetsMake(radius, radius, radius, radius);
+  image.resizingMode = NSImageResizingModeStretch;
+  return image;
+}
+
+- (instancetype)initWithWindow:(NSWindow *)parent
+                          mode:(a2_overlay_mode_t)mode
+                    canRestart:(BOOL)canRestart
+                            fn:(a2_overlay_action_fn)fn {
+  if (!(self = [super init]))
+    return nil;
+  _parent = parent;
+  _mode = mode;
+  _fn = fn;
+  _soundOn = YES;
+
+  _panel = [[NSPanel alloc] initWithContentRect:NSMakeRect(0, 0, 100, kPillHeight)
+                                      styleMask:NSWindowStyleMaskBorderless | NSWindowStyleMaskNonactivatingPanel
+                                        backing:NSBackingStoreBuffered
+                                          defer:NO];
+  _panel.opaque = NO;
+  _panel.backgroundColor = [NSColor clearColor];
+  _panel.hasShadow = YES;
+  _panel.hidesOnDeactivate = NO;
+  _panel.becomesKeyOnlyIfNeeded = YES;
+  _panel.releasedWhenClosed = NO;
+  _panel.excludedFromWindowsMenu = YES;
+  _panel.collectionBehavior = NSWindowCollectionBehaviorFullScreenAuxiliary;
+
+  NSVisualEffectView *pill = [[NSVisualEffectView alloc] initWithFrame:_panel.contentView.bounds];
+  pill.material = NSVisualEffectMaterialHUDWindow;
+  pill.blendingMode = NSVisualEffectBlendingModeBehindWindow;
+  pill.state = NSVisualEffectStateActive;
+  pill.appearance = [NSAppearance appearanceNamed:NSAppearanceNameDarkAqua];
+  pill.maskImage = rounded_mask(kCornerRadius);
+  pill.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+  _panel.contentView = pill;
+
+  _restart = [self buttonWithSymbol:@"arrow.clockwise" label:@"Restart" tag:A2_OVERLAY_RESTART];
+  _joystick = [self buttonWithSymbol:@"gamecontroller" label:@"Joystick mode (F7)" tag:A2_OVERLAY_JOYSTICK];
+  A2OverlayButton *picture = [self buttonWithSymbol:@"paintpalette"
+                                              label:@"Next colour mode (F3)"
+                                                tag:A2_OVERLAY_PICTURE];
+  _sound = [self buttonWithSymbol:@"speaker.wave.2.fill" label:@"Sound on or off" tag:A2_OVERLAY_SOUND];
+  _fullscreen = [self buttonWithSymbol:@"arrow.up.left.and.arrow.down.right"
+                                 label:@"Full screen"
+                                   tag:A2_OVERLAY_FULLSCREEN];
+  NSMutableArray<NSView *> *buttons = [NSMutableArray arrayWithObjects:_joystick, picture, _sound, _fullscreen, nil];
+  if (canRestart)
+    [buttons insertObject:_restart atIndex:0];
+  _stack = [NSStackView stackViewWithViews:buttons];
+  _stack.orientation = NSUserInterfaceLayoutOrientationHorizontal;
+  _stack.spacing = 4;
+  [pill addSubview:_stack];
+
+  NSTrackingAreaOptions options = NSTrackingMouseMoved | NSTrackingMouseEnteredAndExited | NSTrackingActiveAlways |
+      NSTrackingInVisibleRect;
+  [parent.contentView addTrackingArea:[[NSTrackingArea alloc] initWithRect:NSZeroRect
+                                                                    options:options
+                                                                      owner:self
+                                                                   userInfo:@{@"area" : @"game"}]];
+  [pill addTrackingArea:[[NSTrackingArea alloc] initWithRect:NSZeroRect
+                                                     options:NSTrackingMouseEnteredAndExited | NSTrackingActiveAlways |
+                                                         NSTrackingInVisibleRect
+                                                       owner:self
+                                                    userInfo:@{@"area" : @"pill"}]];
+
+  NSNotificationCenter *center = [NSNotificationCenter defaultCenter];
+  for (NSNotificationName name in @[
+         NSWindowDidResizeNotification, NSWindowDidEnterFullScreenNotification,
+         NSWindowDidExitFullScreenNotification
+       ])
+    [center addObserver:self selector:@selector(parentChanged:) name:name object:parent];
+
+  [self layoutPill];
+  [parent addChildWindow:_panel ordered:NSWindowAbove];
+  [self wake];
+  return self;
+}
+
+- (A2OverlayButton *)buttonWithSymbol:(NSString *)symbol label:(NSString *)label tag:(a2_overlay_action_t)tag {
+  A2OverlayButton *button = [[A2OverlayButton alloc] initWithFrame:NSMakeRect(0, 0, kButtonWidth, kButtonHeight)];
+  button.bordered = NO;
+  button.imagePosition = NSImageOnly;
+  button.contentTintColor = [NSColor whiteColor];
+  button.toolTip = label;
+  button.tag = tag;
+  button.target = self;
+  button.action = @selector(pressed:);
+  [self setSymbol:symbol label:label on:button];
+  [button.widthAnchor constraintEqualToConstant:kButtonWidth].active = YES;
+  [button.heightAnchor constraintEqualToConstant:kButtonHeight].active = YES;
+  return button;
+}
+
+- (void)setSymbol:(NSString *)symbol label:(NSString *)label on:(NSButton *)button {
+  NSImageSymbolConfiguration *config = [NSImageSymbolConfiguration configurationWithPointSize:15
+                                                                                       weight:NSFontWeightSemibold];
+  NSImage *image = [[NSImage imageWithSystemSymbolName:symbol accessibilityDescription:label]
+      imageWithSymbolConfiguration:config];
+  if (image) {
+    button.image = image;
+    button.imagePosition = NSImageOnly;
+  } else {
+    button.title = [label substringToIndex:1];
+    button.imagePosition = NSNoImage;
+  }
+  button.accessibilityLabel = label;
+}
+
+- (void)layoutPill {
+  NSSize fit = _stack.fittingSize;
+  CGFloat width = fit.width + 2 * kPillPadding;
+  NSRect content = [_parent contentRectForFrameRect:_parent.frame];
+  NSRect frame = NSMakeRect(round(NSMidX(content) - width / 2), NSMinY(content) + kBottomGap, width, kPillHeight);
+  [_panel setFrame:frame display:YES];
+  _stack.frame = NSMakeRect(kPillPadding, (kPillHeight - fit.height) / 2, fit.width, fit.height);
+}
+
+- (void)parentChanged:(NSNotification *)note {
+  BOOL full = (_parent.styleMask & NSWindowStyleMaskFullScreen) != 0;
+  [self setSymbol:full ? @"arrow.down.right.and.arrow.up.left" : @"arrow.up.left.and.arrow.down.right"
+            label:full ? @"Leave full screen" : @"Full screen"
+               on:_fullscreen];
+  [self layoutPill];
+}
+
+// ---- showing and fading ----
+
+- (void)wake {
+  if (_mode == A2_OVERLAY_HIDDEN)
+    return;
+  [_hideTimer invalidate];
+  _hideTimer = nil;
+  _panel.ignoresMouseEvents = NO;
+  [NSAnimationContext runAnimationGroup:^(NSAnimationContext *context) {
+    context.duration = 0.15;
+    self->_panel.animator.alphaValue = 1;
+  }];
+  if (_mode == A2_OVERLAY_FADE && !_hovering && !_restartArmed)
+    _hideTimer = [NSTimer scheduledTimerWithTimeInterval:kIdleSeconds
+                                                  target:self
+                                                selector:@selector(fade:)
+                                                userInfo:nil
+                                                 repeats:NO];
+}
+
+- (void)fade:(NSTimer *)timer {
+  _hideTimer = nil;
+  [NSAnimationContext
+      runAnimationGroup:^(NSAnimationContext *context) {
+        context.duration = 0.5;
+        self->_panel.animator.alphaValue = 0;
+      }
+      completionHandler:^{
+        if (self->_panel.alphaValue == 0)
+          self->_panel.ignoresMouseEvents = YES;
+      }];
+}
+
+- (void)mouseMoved:(NSEvent *)event {
+  [self wake];
+}
+
+- (void)mouseEntered:(NSEvent *)event {
+  if ([event.trackingArea.userInfo[@"area"] isEqual:@"pill"])
+    _hovering = YES;
+  [self wake];
+}
+
+- (void)mouseExited:(NSEvent *)event {
+  if ([event.trackingArea.userInfo[@"area"] isEqual:@"pill"]) {
+    _hovering = NO;
+    [self wake];
+  }
+}
+
+// ---- buttons ----
+
+- (void)pressed:(NSButton *)sender {
+  a2_overlay_action_t action = (a2_overlay_action_t)sender.tag;
+  if (action == A2_OVERLAY_RESTART && !_restartArmed) {
+    [self armRestart];
+    return;
+  }
+  if (action == A2_OVERLAY_RESTART)
+    [self disarmRestart:nil];
+  _fn(action);
+  [self wake];
+}
+
+- (void)armRestart {
+  _restartArmed = YES;
+  _restart.contentTintColor = [NSColor systemRedColor];
+  [self setSymbol:@"exclamationmark.arrow.circlepath" label:@"Click again to restart" on:_restart];
+  _restart.toolTip = @"Click again to restart. Anything not saved is lost.";
+  _disarmTimer = [NSTimer scheduledTimerWithTimeInterval:kRestartArmSeconds
+                                                  target:self
+                                                selector:@selector(disarmRestart:)
+                                                userInfo:nil
+                                                 repeats:NO];
+  [self wake];
+}
+
+- (void)disarmRestart:(NSTimer *)timer {
+  [_disarmTimer invalidate];
+  _disarmTimer = nil;
+  _restartArmed = NO;
+  _restart.contentTintColor = [NSColor whiteColor];
+  [self setSymbol:@"arrow.clockwise" label:@"Restart" on:_restart];
+  _restart.toolTip = @"Restart";
+  [self wake];
+}
+
+- (void)setJoystick:(BOOL)joystickOn sound:(BOOL)soundOn {
+  _joystickOn = joystickOn;
+  _soundOn = soundOn;
+  _joystick.contentTintColor = joystickOn ? [NSColor controlAccentColor] : [NSColor whiteColor];
+  [self setSymbol:joystickOn ? @"gamecontroller.fill" : @"gamecontroller"
+            label:joystickOn ? @"Joystick mode is on (F7)" : @"Joystick mode (F7)"
+               on:_joystick];
+  [self setSymbol:soundOn ? @"speaker.wave.2.fill" : @"speaker.slash.fill"
+            label:soundOn ? @"Turn sound off" : @"Turn sound on"
+               on:_sound];
+}
+
+@end
+
+static A2OverlayController *s_overlay;
+
+void a2_overlay_create(const void *nsWindow, a2_overlay_mode_t mode, bool canRestart, a2_overlay_action_fn fn) {
+  if (s_overlay || !nsWindow || mode == A2_OVERLAY_HIDDEN)
+    return;
+  s_overlay = [[A2OverlayController alloc] initWithWindow:(__bridge NSWindow *)nsWindow
+                                                     mode:mode
+                                               canRestart:canRestart
+                                                       fn:fn];
+}
+
+void a2_overlay_set_state(bool joystickOn, bool soundOn) {
+  [s_overlay setJoystick:joystickOn sound:soundOn];
+}
+
+void a2_overlay_wake(void) {
+  [s_overlay wake];
+}

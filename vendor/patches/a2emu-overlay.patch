+/// \file
+/// The floating buttons over the game window (macOS only; a no-op elsewhere).
+/// They never reach the emulated machine directly: each button calls back into
+/// a2host_gui.c, which does exactly what the matching key does.
+
+#pragma once
+
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef enum {
+  A2_OVERLAY_FADE, ///< Shown when the mouse moves over the game, then fade out.
+  A2_OVERLAY_ALWAYS,
+  A2_OVERLAY_HIDDEN,
+} a2_overlay_mode_t;
+
+typedef enum {
+  A2_OVERLAY_RESTART,
+  A2_OVERLAY_JOYSTICK,
+  A2_OVERLAY_PICTURE,
+  A2_OVERLAY_SOUND,
+  A2_OVERLAY_FULLSCREEN,
+} a2_overlay_action_t;
+
+typedef void (*a2_overlay_action_fn)(a2_overlay_action_t action);
+
+/// Attach the buttons to \p nsWindow (an NSWindow *). \p canRestart hides the
+/// restart button for engines that cannot reboot.
+void a2_overlay_create(const void *nsWindow, a2_overlay_mode_t mode, bool canRestart, a2_overlay_action_fn fn);
+/// Reflect the joystick and sound state in the buttons.
+void a2_overlay_set_state(bool joystickOn, bool soundOn);
+/// Show the buttons, as when the mouse moves over the game.
+void a2_overlay_wake(void);
+
+#ifdef __cplusplus
+}
+#endif

+/// Puts a different disk in a drive while the machine runs. The head stays on
+/// the track it was on, as it does when a real disk is swapped; only the
+/// rotational position starts over.
+bool swapDisk(int drive, const std::string &path) {
+  FILE *f = fopen(path.c_str(), "rb");
+  if (!f) {
+    fprintf(stderr, "control: cannot open %s: %s\n", path.c_str(), strerror(errno));
+    return false;
+  }
+  auto data = readAll<std::vector<uint8_t>>(f);
+  fclose(f);
+  a2_disk2_drive_t &drv = a2host_io()->disk2.drive[drive];
+  int track = drv.current_track;
+  if (!a2_disk2_mount(&a2host_io()->disk2, drive, data.data(), data.size())) {
+    fprintf(stderr, "control: %s is not a 140K .dsk image; drive %d unchanged\n", path.c_str(), drive + 1);
+    return false;
+  }
+  drv.current_track = track;
+  a2_disk2_install_rom(s_emu.getMainRAMWritable());
+  fprintf(stderr, "control: [frame %u] drive %d now holds %s\n", a2host_frame_no(), drive + 1, path.c_str());
+  return true;
 }
 
+void runControlCommand(const std::string &line) {
+  int drive = 0;
+  char verb[8] = {0};
+  int consumed = 0;
+  if (sscanf(line.c_str(), "%7s %d %n", verb, &drive, &consumed) < 2 || drive < 1 || drive > 2) {
+    fprintf(stderr, "control: ignored \"%s\" (expected \"mount 1|2 PATH\" or \"eject 1|2\")\n", line.c_str());
+    return;
+  }
+  if (strcmp(verb, "mount") == 0 && consumed > 0 && (size_t)consumed < line.size()) {
+    swapDisk(drive - 1, line.substr((size_t)consumed));
+  } else if (strcmp(verb, "eject") == 0) {
+    a2_disk2_unmount(&a2host_io()->disk2, drive - 1);
+    fprintf(stderr, "control: [frame %u] drive %d is empty\n", a2host_frame_no(), drive);
+  } else {
+    fprintf(stderr, "control: ignored \"%s\"\n", line.c_str());
+  }
+}
+
+void pollControl() {
+  if (s_controlFd < 0)
+    return;
+  char buf[1024];
+  for (;;) {
+    ssize_t n = read(s_controlFd, buf, sizeof(buf));
+    if (n > 0) {
+      s_controlPending.append(buf, (size_t)n);
+      continue;
+    }
+    if (n == 0 || (errno != EAGAIN && errno != EINTR)) {
+      // The front end closed the pipe; the machine keeps running.
+      close(s_controlFd);
+      s_controlFd = -1;
+    }
+    break;
+  }
+  size_t newline;
+  while ((newline = s_controlPending.find('\n')) != std::string::npos) {
+    std::string line = s_controlPending.substr(0, newline);
+    s_controlPending.erase(0, newline + 1);
+    if (!line.empty() && line.back() == '\r')
+      line.pop_back();
+    if (!line.empty())
+      runControlCommand(line);
+  }
+  if (s_controlPending.size() > kControlLineMax) {
+    fprintf(stderr, "control: dropped an over-long line\n");
+    s_controlPending.clear();
+  }
+}

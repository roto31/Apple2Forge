diff --color -ruN a/lib/a2host/a2host_disk_menu.m b/lib/a2host/a2host_disk_menu.m
--- a/lib/a2host/a2host_disk_menu.m	1969-12-31 18:00:00
+++ b/lib/a2host/a2host_disk_menu.m	2026-10-11 22:33:33
@@ -0,0 +1,215 @@
+/*
+ * Copyright (c) Tzvetan Mikov.
+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+#import <Cocoa/Cocoa.h>
+
+#include "a2host_disk_menu.h"
+#include "apple2tc/a2engine.h"
+
+static const NSUInteger kDiskBytes = 143360;
+
+@interface A2DiskMenuController : NSObject
+@end
+
+@implementation A2DiskMenuController {
+  NSString *_resourcesDir;
+  NSMutableArray<NSDictionary *> *_sides;
+  NSString *_drive1Path;
+  NSString *_drive2Path;
+  NSMenu *_diskMenu;
+}
+
+- (instancetype)initWithTsv:(NSString *)tsvPath resources:(NSString *)resourcesDir disk1:(NSString *)disk1
+                    disk2:(NSString *)disk2 {
+  if (!(self = [super init]))
+    return nil;
+  _resourcesDir = [resourcesDir copy];
+  _drive1Path = disk1 ? [disk1 copy] : nil;
+  _drive2Path = disk2 ? [disk2 copy] : nil;
+  _sides = [NSMutableArray array];
+  NSString *text = [NSString stringWithContentsOfFile:tsvPath encoding:NSUTF8StringEncoding error:nil];
+  if (!text)
+    return self;
+  for (NSString *line in [text componentsSeparatedByString:@"\n"]) {
+    NSString *trimmed = [line stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
+    if (trimmed.length == 0)
+      continue;
+    NSArray<NSString *> *parts = [trimmed componentsSeparatedByString:@"\t"];
+    if (parts.count < 3)
+      continue;
+    [_sides addObject:@{@"startup" : parts[0], @"label" : parts[1], @"file" : parts[2]}];
+  }
+  _diskMenu = [self buildMenu];
+  [self installInMainMenu];
+  return self;
+}
+
+- (NSString *)fullPathForBundleFile:(NSString *)file {
+  return [_resourcesDir stringByAppendingPathComponent:file];
+}
+
+- (void)queueMount:(int)drive path:(NSString *)path {
+  NSString *cmd = [NSString stringWithFormat:@"mount %d %@", drive, path];
+  engine_queue_disk_command(cmd.UTF8String);
+}
+
+- (void)queueEject:(int)drive {
+  NSString *cmd = [NSString stringWithFormat:@"eject %d", drive];
+  engine_queue_disk_command(cmd.UTF8String);
+}
+
+- (BOOL)mountPath:(NSString *)path drive:(int)drive {
+  NSDictionary *attrs = [[NSFileManager defaultManager] attributesOfItemAtPath:path error:nil];
+  NSNumber *size = attrs[NSFileSize];
+  if (!size || size.unsignedIntegerValue != kDiskBytes) {
+    NSAlert *alert = [[NSAlert alloc] init];
+    alert.alertStyle = NSAlertStyleCritical;
+    alert.messageText = @"Not a 140K disk image";
+    alert.informativeText = [NSString stringWithFormat:@"%@ is %@ bytes; a DOS 3.3 sector image is %lu bytes.",
+                                                       path.lastPathComponent, size ?: @0, (unsigned long)kDiskBytes];
+    [alert runModal];
+    return NO;
+  }
+  [self queueMount:drive path:path];
+  if (drive == 1)
+    _drive1Path = [path copy];
+  else
+    _drive2Path = [path copy];
+  _diskMenu = [self buildMenu];
+  return YES;
+}
+
+- (void)insertSide:(NSDictionary *)side drive:(int)drive {
+  NSString *path = [self fullPathForBundleFile:side[@"file"]];
+  [self mountPath:path drive:drive];
+}
+
+- (void)otherDisk:(int)drive {
+  NSOpenPanel *panel = [NSOpenPanel openPanel];
+  panel.canChooseFiles = YES;
+  panel.canChooseDirectories = NO;
+  panel.allowsMultipleSelection = NO;
+  panel.allowedFileTypes = @[ @"dsk", @"do", @"po" ];
+  panel.message = [NSString stringWithFormat:@"Choose a 140K disk image for drive %d", drive];
+  if ([panel runModal] != NSModalResponseOK || !panel.URL)
+    return;
+  [self mountPath:panel.URL.path drive:drive];
+}
+
+- (NSMenuItem *)itemWithTitle:(NSString *)title action:(SEL)action tag:(NSInteger)tag {
+  NSMenuItem *item = [[NSMenuItem alloc] initWithTitle:title action:action keyEquivalent:@""];
+  item.target = self;
+  item.tag = tag;
+  return item;
+}
+
+- (NSMenu *)submenuForDrive:(int)drive {
+  NSMenu *menu = [[NSMenu alloc] initWithTitle:[NSString stringWithFormat:@"Drive %d", drive]];
+  NSString *current = drive == 1 ? _drive1Path : _drive2Path;
+  for (NSUInteger index = 0; index < _sides.count; ++index) {
+    NSDictionary *side = _sides[index];
+    NSString *path = [self fullPathForBundleFile:side[@"file"]];
+    NSString *title = side[@"label"];
+    NSMenuItem *item = [self itemWithTitle:title action:@selector(insertTagged:) tag:drive * 10000 + (NSInteger)index];
+    if (current && [current isEqualToString:path])
+      item.state = NSControlStateValueOn;
+    [menu addItem:item];
+  }
+  [menu addItem:[NSMenuItem separatorItem]];
+  [menu addItem:[self itemWithTitle:@"Other Disk Image…" action:@selector(otherTagged:) tag:drive]];
+  return menu;
+}
+
+- (NSMenu *)buildMenu {
+  NSMenu *menu = [[NSMenu alloc] initWithTitle:@"Disk"];
+  for (int drive = 1; drive <= 2; ++drive) {
+    NSMenuItem *item = [[NSMenuItem alloc] init];
+    item.title = [NSString stringWithFormat:@"Insert into Drive %d", drive];
+    item.submenu = [self submenuForDrive:drive];
+    [menu addItem:item];
+  }
+  [menu addItem:[NSMenuItem separatorItem]];
+  [menu addItem:[self itemWithTitle:@"Eject Drive 1" action:@selector(eject1:) tag:0]];
+  [menu addItem:[self itemWithTitle:@"Eject Drive 2" action:@selector(eject2:) tag:0]];
+  return menu;
+}
+
+- (void)installInMainMenu {
+  NSMenu *main = [NSApp mainMenu];
+  if (!main) {
+    main = [[NSMenu alloc] init];
+    [NSApp setMainMenu:main];
+  }
+  for (NSMenuItem *item in main.itemArray) {
+    if ([item.title isEqualToString:@"Disk"]) {
+      item.submenu = _diskMenu;
+      return;
+    }
+  }
+  NSMenuItem *diskItem = [[NSMenuItem alloc] init];
+  diskItem.title = @"Disk";
+  diskItem.submenu = _diskMenu;
+  [main addItem:diskItem];
+}
+
+- (void)insertTagged:(NSMenuItem *)sender {
+  NSInteger tag = sender.tag;
+  int drive = (int)(tag / 10000);
+  NSInteger index = tag % 10000;
+  if (index < 0 || index >= (NSInteger)_sides.count)
+    return;
+  [self insertSide:_sides[index] drive:drive];
+}
+
+- (void)otherTagged:(NSMenuItem *)sender {
+  [self otherDisk:(int)sender.tag];
+}
+
+- (void)eject1:(id)sender {
+  (void)sender;
+  [self queueEject:1];
+  _drive1Path = nil;
+  _diskMenu = [self buildMenu];
+}
+
+- (void)eject2:(id)sender {
+  (void)sender;
+  [self queueEject:2];
+  _drive2Path = nil;
+  _diskMenu = [self buildMenu];
+}
+
+- (void)showPopupFromView:(NSView *)view {
+  NSMenu *menu = _diskMenu ?: [self buildMenu];
+  NSPoint loc = NSMakePoint(0, view.bounds.size.height);
+  [menu popUpMenuPositioningItem:nil atLocation:loc inView:view];
+}
+
+@end
+
+static A2DiskMenuController *s_diskMenu;
+
+void a2_disk_menu_install(const char *diskSetTsv, const char *resourcesDir, const char *disk1Path,
+                          const char *disk2Path) {
+  if (!diskSetTsv || !resourcesDir || s_diskMenu)
+    return;
+  @autoreleasepool {
+    s_diskMenu = [[A2DiskMenuController alloc] initWithTsv:@(diskSetTsv)
+                                               resources:@(resourcesDir)
+                                                     disk1:disk1Path ? @(disk1Path) : nil
+                                                     disk2:disk2Path ? @(disk2Path) : nil];
+  }
+}
+
+void a2_disk_menu_show_popup(void *nsViewOrNil) {
+  if (!s_diskMenu)
+    return;
+  NSView *view = nsViewOrNil ? (__bridge NSView *)nsViewOrNil : nil;
+  if (!view)
+    return;
+  [s_diskMenu showPopupFromView:view];
+}

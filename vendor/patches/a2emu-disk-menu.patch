+extern "C" const char *engine_disk_path(int drive) {
+  if (drive == 0)
+    return s_disk1Path.empty() ? nullptr : s_disk1Path.c_str();
+  if (drive == 1)
+    return s_disk2Path.empty() ? nullptr : s_disk2Path.c_str();
+  return nullptr;
 }
 

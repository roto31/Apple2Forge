+extern "C" void engine_queue_disk_command(const char *line) {
+  if (!line || !*line)
+    return;
+  std::string cmd(line);
+  while (!cmd.empty() && (cmd.back() == '\n' || cmd.back() == '\r'))
+    cmd.pop_back();
+  if (!cmd.empty())
+    s_controlQueued.push_back(cmd);
+}

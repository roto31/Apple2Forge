+/// Disk menu. \p resourcesDir holds the bundled .dsk files; \p disk1Path and
+/// \p disk2Path are the images initially mounted (may be NULL).
+void a2_disk_menu_install(const char *diskSetTsv, const char *resourcesDir, const char *disk1Path,
+                          const char *disk2Path);
